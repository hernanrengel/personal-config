{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "~/.config/fastfetch/logo_active.png",
    "width": 32,
    "padding": {
      "top": 5,
      "right": 4,
      "left": 1
    }
  },
  "display": {
    "separator": "   ",
    "key": {
      "width": 16
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "keyWidth": 0,
      "format": "\u001b[38;2;203;166;247m{user-name}\u001b[38;2;108;112;134m@\u001b[38;2;180;190;254m{host-name}"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;88;91;112m╭─────────────  \u001b[38;2;203;166;247mSystem\u001b[38;2;88;91;112m  ─────────────╮"
    },
    { "type": "os",       "key": "  󰣇 OS",       "keyColor": "38;2;137;180;250" },
    { "type": "kernel",   "key": "  󰌽 Kernel",   "keyColor": "38;2;137;220;235" },
    { "type": "packages", "key": "  󰏖 Packages", "keyColor": "38;2;166;227;161" },
    { "type": "wm",       "key": "  󰖲 WM",       "keyColor": "38;2;203;166;247" },
    { "type": "shell",    "key": "  󰆍 Shell",    "keyColor": "38;2;245;194;231" },
    { "type": "terminal", "key": "  󰍹 Terminal", "keyColor": "38;2;250;179;135" },
    { "type": "uptime",   "key": "  󰅐 Uptime",   "keyColor": "38;2;249;226;175" },
    {
      "type": "custom",
      "format": "\u001b[38;2;88;91;112m├────────────  \u001b[38;2;250;179;135mHardware\u001b[38;2;88;91;112m  ────────────┤"
    },
    { "type": "cpu",    "key": "  󰻠 CPU",  "keyColor": "38;2;243;139;168" },
    { "type": "gpu",    "key": "  󰾲 GPU",  "keyColor": "38;2;235;160;172", "detectionMethod": "pci" },
    { "type": "memory", "key": "  󰍛 RAM",  "keyColor": "38;2;166;227;161" },
    { "type": "disk",   "key": "  󰋊 Disk", "keyColor": "38;2;249;226;175", "folders": "/" },
    {
      "type": "custom",
      "format": "\u001b[38;2;88;91;112m╰──────────────────────────────────────────╯"
    },
    "break",
    {
      "type": "colors",
      "paddingLeft": 3,
      "symbol": "circle"
    }
  ]
}
