// -*- mode: jsonc -*-
// THEME: Brutalist / Swiss
{
    "position": "top",
    "margin-top": 13,
    "margin-right": 20,
    "margin-left": 20,

    "custom/bluetooth": {
        "exec": "~/.config/waybar/scripts/bluetooth.sh",
        "interval": 5,
        "return-type": "json",
        "on-click": "~/.local/bin/bluetooth-popup.sh",
        "on-click-right": "blueman-manager"
    },
    "custom/playerctl": {
        "format": "{}",
        "exec": "playerctl --ignore-player=mpv metadata --format '{{emoji(status)}} {{artist}} - {{title}}' 2>/dev/null || echo 'NO MUSIC'",
        "max-length": 34,
        "on-click": "playerctl --ignore-player=mpv play-pause",
        "on-scroll-up": "playerctl --ignore-player=mpv next",
        "on-scroll-down": "playerctl --ignore-player=mpv previous",
        "interval": 2,
        "return-type": "text"
    },
    "custom/monitor-toggle": {
        "format": "{}",
        "return-type": "json",
        "exec": "/home/brosso3d/.config/hypr/scripts/toggle-internal-monitor.sh --status",
        "on-click": "/home/brosso3d/.config/hypr/scripts/toggle-internal-monitor.sh --toggle",
        "interval": 2,
        "tooltip": true
    },
    "custom/super-drag": {
        "exec": "/home/brosso3d/.config/hypr/scripts/super-drag-status.sh",
        "interval": 2,
        "on-click": "/home/brosso3d/.config/hypr/scripts/toggle-super-drag.sh",
        "tooltip": false,
        "format": "{}"
    },

    "modules-left": [
        "clock",
        "custom/playerctl"
    ],
    "modules-center": [
        "hyprland/workspaces"
    ],
    "modules-right": [
        "memory",
        "cpu",
        "temperature",
        "custom/gpu",
        "custom/gpu-mode",
        "custom/super-drag",
        "custom/monitor-toggle",
        "custom/kb-backlight",
        "network",
        "pulseaudio",
        "custom/bluetooth",
        "power-profiles-daemon",
        "battery"
    ],

    "hyprland/workspaces": {
        "format": "{name}",
        "persistent-workspaces": {
            "*": 5,
            "HDMI-A-1": 3
        }
    },

    "clock": {
        "format": "<span size='xx-large' weight='ultrabold'>{0:%H:%M}</span>",
        "tooltip-format": "<big>{:%A, %B %d, %Y}</big>\n<tt><small>{calendar}</small></tt>",
        "on-click": "~/.local/bin/calendar-popup.sh"
    },
    "cpu": {
        "format": "CPU {usage}",
        "tooltip": false,
        "on-click": "~/.local/bin/stats-popup.sh"
    },
    "custom/gpu": {
        "exec": "v=$(nvidia-smi --query-gpu=utilization.gpu --format=csv,noheader,nounits 2>/dev/null); case \"$v\" in ''|*[!0-9]*) echo 'GPU OFF';; *) echo \"GPU $v\";; esac",
        "interval": 3,
        "format": "{}",
        "tooltip": false,
        "on-click": "~/.local/bin/stats-popup.sh"
    },
    "custom/gpu-mode": {
        "exec": "~/.config/waybar/scripts/gpu-mode.sh",
        "interval": 5,
        "return-type": "json",
        "on-click": "~/.config/waybar/scripts/gpu-mode-cycle.sh",
        "tooltip": true
    },
    "custom/kb-backlight": {
        "exec": "~/.config/waybar/scripts/kb-backlight.sh",
        "interval": 3,
        "return-type": "json",
        "on-click": "~/.config/waybar/scripts/kb-backlight-cycle.sh",
        "tooltip": true
    },
    "memory": {
        "interval": 3,
        "format": "MEM {percentage}",
        "tooltip-format": "RAM {used:0.1f} GiB / {total:0.1f} GiB ({percentage}%)",
        "on-click": "~/.local/bin/stats-popup.sh"
    },
    "temperature": {
        "critical-threshold": 80,
        "format": "{temperatureC}°",
        "tooltip": false
    },
    "battery": {
        "bat": "BAT0",
        "adapter": "ADP1",
        "states": { "good": 95, "warning": 35, "critical": 25 },
        "format": "BAT {capacity}",
        "format-charging": "CHR {capacity}",
        "format-plugged": "PLG {capacity}",
        "on-click": "~/.local/bin/battery-popup.sh"
    },
    "power-profiles-daemon": {
        "format": "{icon}",
        "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
        "tooltip": true,
        "on-click": "asusctl profile next",
        "format-icons": {
            "default": "PERF",
            "performance": "PERF",
            "balanced": "BAL",
            "power-saver": "ECO"
        }
    },
    "network": {
        "format-wifi": "WIFI {signalStrength}",
        "format-ethernet": "ETH",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ifname} via {gwaddr}",
        "tooltip-format": "{ifname} via {gwaddr}",
        "format-linked": "LINK",
        "format-disconnected": "OFFLINE",
        "on-click": "~/.local/bin/wofi-wifi-menu.sh"
    },
    "pulseaudio": {
        "format": "VOL {volume}",
        "format-muted": "MUTE",
        "on-click": "~/.local/bin/audio-popup.sh",
        "on-click-right": "pavucontrol",
        "on-scroll-up": "pamixer -i 5",
        "on-scroll-down": "pamixer -d 5"
    }
}
